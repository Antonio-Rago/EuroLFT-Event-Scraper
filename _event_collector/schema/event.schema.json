{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "enum": [
        "collected",
        "manual"
      ]
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "related_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "maxLength": 160
          },
          "relation": {
            "enum": [
              "satellite_of",
              "has_satellite",
              "related_to"
            ]
          }
        },
        "required": [
          "id",
          "relation"
        ]
      }
    },
    "identity_aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "editor_overrides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/facts/"
      },
      "uniqueItems": true
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "origin",
    "facts",
    "sources",
    "evidence",
    "related_events",
    "identity_aliases",
    "warnings",
    "editor_overrides",
    "decision",
    "history"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EuroLFT canonical community event record v1",
  "description": "Human-reviewed registry format; not the extraction model output or public export format.",
  "$defs": {
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "conference",
            "workshop",
            "school",
            "software_training",
            "course",
            "seminar",
            "collaboration_meeting",
            "other",
            "unknown"
          ]
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "venue": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "city": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "country": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "venue",
            "city",
            "country"
          ]
        },
        "attendance": {
          "enum": [
            "unknown",
            "in_person",
            "online",
            "hybrid"
          ]
        },
        "official_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "registration",
                  "abstract",
                  "payment",
                  "funding",
                  "visa",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "time": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timezone": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "label",
              "date",
              "time",
              "timezone"
            ]
          }
        },
        "lifecycle": {
          "enum": [
            "scheduled",
            "cancelled",
            "unknown"
          ]
        }
      },
      "required": [
        "title",
        "type",
        "start_date",
        "end_date",
        "start_time",
        "end_time",
        "timezone",
        "location",
        "attendance",
        "official_url",
        "summary",
        "deadlines",
        "lifecycle"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "announcement",
            "organiser",
            "editor"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "posted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "posted_at",
        "retrieved_at",
        "note"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^/facts/"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 160
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "field",
        "source_id",
        "excerpt"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "draft",
            "approved",
            "rejected",
            "hidden"
          ]
        },
        "reviewed_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledged_warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewed_content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "status",
        "reviewed_revision",
        "reason",
        "acknowledged_warnings"
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "approve",
            "reject",
            "hide",
            "restore",
            "edit",
            "merge"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "actor",
        "at",
        "revision",
        "note"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "facts": {
            "properties": {
              "type": {
                "enum": [
                  "conference",
                  "workshop",
                  "school",
                  "software_training",
                  "course"
                ]
              },
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "lifecycle": {
                "enum": [
                  "scheduled",
                  "cancelled"
                ]
              }
            }
          },
          "decision": {
            "properties": {
              "reviewed_revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "hidden"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
